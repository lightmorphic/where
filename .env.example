# Copy this file to .env and change what you need. docker-compose.yml reads it,
# so you never have to edit the compose file itself.

# The port you open in the browser: http://<server>:4150
WHERE_PORT=4150

# Host folder that holds the database, the photos and the downloaded model.
# Back this up and you have everything.
WHERE_DATA=/opt/where

# The vision model that writes descriptions from photos.
# "http://ollama:11434" is the Ollama container started alongside the app.
# Point it elsewhere if you already run Ollama on another machine.
OLLAMA_HOST=http://ollama:11434

# Which model to ask for. Downloaded automatically the first time it is needed.
# moondream is small and quick. Try llava or minicpm-v for better descriptions
# on a machine with more memory.
OLLAMA_MODEL=moondream

# Leave blank to bake whatever address you are browsing from into QR labels.
# Set it if you always want labels to open one particular address, e.g.
# https://homelab.ibis-porgy.ts.net:4150
WHERE_PUBLIC_URL=

TZ=Europe/London
